<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: BFD3E6;" stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.FormController">
    <top>
        <HBox spacing="16" style="-fx-background-color: BFD3E6;" styleClass="header">
            <Label styleClass="title" text="Tambah Produk" />
            <Button onAction="#bukaDaftar" style="-fx-background-color: #888CBB;" text="Lihat Daftar" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" style="-fx-background-color: #1D223F;" styleClass="page">
                    <VBox spacing="12" style="-fx-background-color: #F3EBDD;" styleClass="card">
                        <Label styleClass="subtitle" text="Buat produk baru" />
                        <Label styleClass="muted" text="ada produk baru apa nichh?" wrapText="true" />
                        <Label text="Nama produk" />
                        <TextField fx:id="namaField" promptText="contoh : matcha" />
                        <Label text="Kategori" />
                        <ComboBox fx:id="kategoriBox" maxWidth="Infinity" style="-fx-background-color: BFD3E6;" />
                        <Label text="Harga produk (Rp)" />
                        <TextField fx:id="hargaField" promptText="Contoh: 15000" />
                        <Button maxWidth="Infinity" onAction="#simpan" style="-fx-background-color: #888CBB;" styleClass="button-primary" text="Simpan Produk" />
                        <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
