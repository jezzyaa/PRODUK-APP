<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: BFD3E6;" stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DetailController">
    <top>
        <HBox spacing="16" style="-fx-background-color: BFD3E6;" styleClass="header">
            <Label styleClass="title" text="Detail Produk" />
            <Button onAction="#bukaDaftar" style="-fx-background-color: #888CBB;" text="Lihat Daftar" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" style="-fx-background-color: #1D223F;" styleClass="page">
                    <VBox spacing="10" style="-fx-background-color: #F3EBDD;" styleClass="card">
                        <Label styleClass="muted" text="Kode produk" textFill="#badaf8" />
                        <Label fx:id="kodeLabel" styleClass="subtitle" />
                        <Label styleClass="muted" text="Nama produk" />
                        <Label fx:id="namaLabel" wrapText="true" />
                        <Label styleClass="muted" text="Kategori" />
                        <Label fx:id="kategoriLabel" />
                        <Label styleClass="muted" text="Harga" />
                        <Label fx:id="hargaLabel" styleClass="title" />
                        <Button onAction="#tambahLagi" style="-fx-background-color: #888CBB;" styleClass="button-primary" text="Tambah Produk Lain" />
                        <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
